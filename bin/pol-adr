#!/bin/sh
# Copyright (C) 2026 Alex Kunich
# SPDX-License-Identifier: AGPL-3.0-or-later
# pol-adr — one finished design -> architecture decision records.
#
# An ADR is normally the part of architecture work that rots first: written
# after the fact, from memory, and never re-checked. Here every line of it is a
# row derived from the model, so re-running the tool after a change re-derives
# the record. A rationale that disagrees with the design becomes impossible
# rather than merely embarrassing.
#
# WHY IT DOES NOT JUST PRINT `pol derive --why`. The derivation tree for a
# chosen part proves that it WAS chosen — `is extract.chosen llm-vision`, and
# little else. The interesting half of a decision is what was rejected and on
# which requirement, and that is a separate derivation (the `rejected-*`
# relations). The tree is included underneath as the proof, not as the reason.
#
# Usage:  pol-adr MODEL.pol RULES.rules STATE
set -eu
model=${1:?usage: pol-adr MODEL.pol RULES.rules STATE}
rules=${2:?}
state=${3:?}
POL=${POL:-pol}

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
rows() { "$POL" derive "$model" "$rules" "$1" 2>/dev/null | awk -v n="$2" 'NR>1 && NF==n'; }

rows "(blueprint $state K C)" 3 | awk '{print $2, $3}' >"$tmp/design"
rows "(box-tech $state K T)"  3 | awk '{print $2, $3}' >"$tmp/tech"
rows "(box-level $state K L)" 3 | awk '{print $2, $3}' >"$tmp/level"
rows "(box-within $state K B)" 3 | awk '{print $2, $3}' >"$tmp/within"
rows candidate 2 >"$tmp/cand"
for r in bulk scan rerun coupling; do rows "rejected-$r" 2 | sed "s/^/$r /" ; done >"$tmp/rej"

[ -s "$tmp/design" ] || { echo "pol-adr: no design at state $state" >&2; exit 1; }

lookup() { awk -v k="$2" '$1==k {print $2; exit}' "$1"; }

cat <<EOF
# Architecture decision records — design $state

Generated by \`pol-adr\` from \`$model\`. **Every statement below is derived**:
each decision, each rejected alternative and each stated reason is a row the
model proves. Re-run after any change and the record re-derives — it cannot
drift away from the design it describes.

EOF

n=0
while read -r stage comp; do
  n=$((n + 1))
  tech=$(lookup "$tmp/tech" "$stage")
  level=$(lookup "$tmp/level" "$stage")
  within=$(lookup "$tmp/within" "$stage")
  printf '## %d. %s — %s\n\n' "$n" "$stage" "$comp"
  printf '**Decision.** `%s`' "$comp"
  [ -n "$tech" ] && printf ' [%s]' "$tech"
  [ -n "$level" ] && printf ', a %s' "$level"
  [ -n "$within" ] && printf ' in the `%s` boundary' "$within"
  printf '.\n\n'

  nc=$(awk -v k="$stage" '$1==k' "$tmp/cand" | wc -l | tr -d ' ')
  nr=$(awk -v k="$stage" '$2==k' "$tmp/rej" | wc -l | tr -d ' ')
  printf '**Alternatives.** %s candidate(s) provide this stage; %s excluded by the brief.\n\n' "$nc" "$nr"

  if [ "$nr" -gt 0 ]; then
    echo '| rejected | because |'
    echo '|---|---|'
    awk -v k="$stage" '$2==k {
      r = $1; c = $3
      if (r == "bulk")     why = "cannot survive the data volume (`needs-bulk`)"
      else if (r == "scan")     why = "cannot read scanned pages (`needs-scan`)"
      else if (r == "rerun")    why = "not reproducible across runs (`needs-rerun`)"
      else if (r == "coupling") why = "couples too tightly (`needs-loose`)"
      else why = r
      printf "| `%s` | %s |\n", c, why
    }' "$tmp/rej"
    echo
  fi

  echo '<details><summary>Proof</summary>'
  echo
  echo '```'
  "$POL" derive "$model" "$rules" --why "(blueprint $state $stage $comp)" 2>&1
  echo '```'
  echo
  echo '</details>'
  echo
done <"$tmp/design"
