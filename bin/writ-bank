#!/bin/sh
# Copyright (C) 2026 Alex Kunich
# SPDX-License-Identifier: AGPL-3.0-or-later
# writ-bank — a component catalogue (Markdown) -> a Writ model (datums).
#
# THIS IS THE TOOL THE LANGUAGE CANNOT BE. A Writ form is rename-and-paste: no
# recursion, no computation, and it cannot map over its `&rest`. So a form
# cannot turn one "component X provides capability Y" row into the named span
# junction that fact requires, and it cannot emit one `pick` move per part.
# Nothing about that is a gap in Writ — it is what keeps a model a finite
# presentation. It is a gap in what a HUMAN should be asked to type.
#
# The semantics stay entirely in Writ. This emits ordinary, readable, diffable
# datums that `writ check` proves exactly as if they had been written out —
# which is the whole reason it is a generator and not a second language.
#
# WHY MARKDOWN. A catalogue is a curated knowledge base that people argue
# about, not a pipeline feed: it wants to render in a pull request, and it wants
# prose. Tables carry the facts, everything else on the page is ignored, and a
# `notes` column documents a row without entering the model.
#
# Usage:  writ-bank CATALOGUE.md [EXTRAS.writ] [--lib PATH]
#
#   Sections are `## Stages`, `## Components`, `## Flows`, `## Actors`.
#   COLUMNS ARE MATCHED BY NAME, so order is free and unknown columns (notes)
#   are skipped. An empty cell or `-` is vacant. `,` separates a list.
#
#   EXTRAS.writ is appended verbatim — for the transitions a catalogue cannot
#   express, such as a declared `gap`.
set -eu

lib=../lib/arch.lib.writ
cat=
extras=
while [ $# -gt 0 ]; do
  case $1 in
  --lib) lib=$2; shift 2 ;;
  *) if [ -z "$cat" ]; then cat=$1; else extras=$1; fi; shift ;;
  esac
done
[ -n "$cat" ] || { echo "usage: writ-bank CATALOGUE.md [EXTRAS.writ] [--lib PATH]" >&2; exit 2; }
[ -f "$cat" ] || { echo "writ-bank: no such catalogue: $cat" >&2; exit 2; }

awk -v LIB="$lib" -v SRC="$cat" '
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
# A trailing `?` marks the cell ASSUMED rather than confirmed. That is
# provenance for `writ-assume`, and no business of the model: it is stripped
# here, so the datums are identical whoever wrote the cell and however sure
# they were. NOTE: no apostrophes in this awk program — it is single-quoted.
function vac(s)  { sub(/\?$/, "", s); return (s == "" || s == "-") ? "-" : s }
# awk runs END even after `exit`, so a fatal must also mute END
function die(m)  { print "writ-bank: " m > "/dev/stderr"; fatal = 1; exit 1 }
# ENTITY-MAJOR emission (kernel §9.2). An instance clause names one entity and
# then every arrow of it, which is the only shape the parser accepts since the
# grammar simplification — the arrow-major form this generator used to print,
# one clause per ARROW listing every entity, is no longer read at all.
#
# Arrows are accumulated per entity by `slot` and flushed by `entities`,
# because awk has no nested arrays and the catalogue is walked column by column.
# `pad` aligns continuation lines under the first arrow clause, which is what
# the committed corpus looks like and what makes a 300-line instance readable.
function slot(ty, name, arrow, val) {
  acc[ty, name] = acc[ty, name] SUBSEP arrow " " (val == "-" ? "vacant" : val)
}
function entities(ty, n, names,   i, j, k, parts, head, pad, out) {
  for (i = 1; i <= n; i++) {
    head = "  (" ty " " names[i]
    pad = sprintf("%" length(head) + 1 "s", "")
    k = split(acc[ty, names[i]], parts, SUBSEP)
    out = head
    for (j = 1; j <= k; j++) {
      if (parts[j] == "") continue
      out = out (out == head ? " " : "\n" pad) "(" parts[j] ")"
    }
    print out ")"
  }
}
# A type whose entities carry no arrows at all is still a roster line.
function roster(ty, n, names,   i, s) {
  s = "  (" ty
  for (i = 1; i <= n; i++) s = s " " names[i]
  print s ")"
}
# value of column NAME in the current row, or "-" if the column is absent
function col(name,   i) { return (name in idx) ? vac(trim(f[idx[name]])) : "-" }
function need(name) { if (!(name in idx)) die("section `" sec "` has no `" name "` column") }

/^##[ \t]/ {
  sec = tolower(trim(substr($0, 4))); delete idx; head = 0; next
}
!/^[ \t]*\|/ { next }                      # prose, headings, HTML comments
/^[ \t]*\|[ \t:|-]*\|[ \t]*$/ { next }     # the |---|---| separator row
{
  line = trim($0)
  sub(/^\|/, "", line); sub(/\|$/, "", line)
  nf = split(line, f, /\|/)
  for (i = 1; i <= nf; i++) f[i] = trim(f[i])

  if (!head) {                             # the header row names the columns
    for (i = 1; i <= nf; i++) if (f[i] != "") idx[f[i]] = i
    head = 1
    next
  }
  if (col("notes") == "-" && nf == 0) next

  if (sec == "stages") {
    need("stage"); need("next")
    ns++; stage[ns] = col("stage"); snext[ns] = col("next")
    nb[ns] = col("needs-bulk"); nsc[ns] = col("needs-scan")
    nr[ns] = col("needs-rerun"); nl[ns] = col("needs-loose")
  } else if (sec == "components") {
    need("name"); need("provides")
    nc++; comp[nc] = col("name"); prov[nc] = col("provides"); reqs[nc] = col("requires")
    cb[nc] = col("bulk");  cs[nc] = col("scans");  cr[nc] = col("rerun")
    cp[nc] = col("persists"); cc[nc] = col("couples")
    cl[nc] = col("level"); ct[nc] = col("tech")
    ce[nc] = col("external"); cw[nc] = col("within")
    if (ct[nc] != "-" && !(ct[nc] in tseen)) { tseen[ct[nc]]; nt++; tech[nt] = ct[nc] }
    if (cw[nc] != "-" && !(cw[nc] in wseen)) { wseen[cw[nc]]; nbd++; bnd[nbd] = cw[nc] }
  } else if (sec == "flows") {
    need("from"); need("to")
    nfl++; ff[nfl] = col("from"); ft[nfl] = col("to"); fv[nfl] = col("via")
  } else if (sec == "actors") {
    need("actor"); need("drives")
    na++; act[na] = col("actor"); adr[na] = col("drives")
  }
}

END {
  if (fatal) exit 1
  if (!ns) die("no `## Stages` table found in " SRC)
  if (!nc) die("no `## Components` table found in " SRC)

  print "; GENERATED by writ-bank — do not edit. Edit the catalogue and re-run:"
  # BASENAME, not the path as given: a generated file whose contents depend on
  # how the generator was invoked is not reproducible, and `regen` would flap
  # between a relative and an absolute call.
  base = SRC; sub(/^.*\//, "", base)
  print ";   writ-bank " base " > this file"
  print ""
  print "(load \"" LIB "\")"
  print ""
  print "(instance bank arch"

  for (i = 1; i <= ns; i++) {
    slot("cap", stage[i], "next", snext[i])
    slot("cap", stage[i], "chosen", "-")
    slot("cap", stage[i], "needs-bulk", nb[i])
    slot("cap", stage[i], "needs-scan", nsc[i])
    slot("cap", stage[i], "needs-rerun", nr[i])
    slot("cap", stage[i], "needs-loose", nl[i])
  }
  entities("cap", ns, stage)
  print ""

  if (nt) roster("technology", nt, tech)
  if (nbd) roster("boundary", nbd, bnd)
  print ""

  for (i = 1; i <= nc; i++) {
    slot("comp", comp[i], "bulk", cb[i])
    slot("comp", comp[i], "scans", cs[i])
    slot("comp", comp[i], "rerunnable", cr[i])
    slot("comp", comp[i], "persists", cp[i])
    slot("comp", comp[i], "couples", cc[i])
    slot("comp", comp[i], "level", cl[i])
    slot("comp", comp[i], "tech", ct[i])
    slot("comp", comp[i], "external", ce[i])
    slot("comp", comp[i], "within", cw[i])
  }
  entities("comp", nc, comp)
  print ""

  if (na) {
    for (i = 1; i <= na; i++) slot("actor", act[i], "drives", adr[i])
    entities("actor", na, act)
    print ""
  }

  if (nfl) {
    for (i = 1; i <= nfl; i++) {
      fid[i] = "fl-" ff[i] "-" ft[i]
      slot("flow", fid[i], "f-from", ff[i])
      slot("flow", fid[i], "f-to", ft[i])
      slot("flow", fid[i], "f-via", fv[i])
    }
    entities("flow", nfl, fid)
    print ""
  }

  np = 0
  for (i = 1; i <= nc; i++) {
    k = split(prov[i], a, ",")
    for (j = 1; j <= k; j++) {
      v = trim(a[j]); if (v == "-" || v == "") continue
      np++; pid[np] = "p-" comp[i] "-" v; pc[np] = comp[i]; pk[np] = v
    }
  }
  for (i = 1; i <= np; i++) {
    slot("prov", pid[i], "p-comp", pc[i])
    slot("prov", pid[i], "p-cap", pk[i])
  }
  entities("prov", np, pid)
  print ""

  nq = 0
  for (i = 1; i <= nc; i++) {
    k = split(reqs[i], a, ",")
    for (j = 1; j <= k; j++) {
      v = trim(a[j]); if (v == "-" || v == "") continue
      nq++; qid[nq] = "r-" comp[i] "-" v; qc[nq] = comp[i]; qk[nq] = v
    }
  }
  if (nq) {
    for (i = 1; i <= nq; i++) {
      slot("req", qid[i], "r-comp", qc[i])
      slot("req", qid[i], "r-cap", qk[i])
    }
    entities("req", nq, qid)
    print ""
  }

  print "  (cursor cur (at " stage[1] ")))"
  print ""
  print "(use arch)"
  print "(initial bank)"
  print ""
  print "; one move per (component, stage) pair — the mapping a form cannot make"
  for (i = 1; i <= np; i++) printf "(pick %s-%s %s %s rr)\n", pk[i], pc[i], pc[i], pk[i]
}
' "$cat"

if [ -n "$extras" ]; then
  echo
  cat "$extras"
fi
