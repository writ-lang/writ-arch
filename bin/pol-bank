#!/bin/sh
# pol-bank — a component catalogue (tables) -> a Pol model (datums).
#
# THIS IS THE TOOL THE LANGUAGE CANNOT BE. A Pol form is rename-and-paste: no
# recursion, no computation, and it cannot map over its `&rest`. So a form
# cannot turn one "component X provides capability Y" row into the named span
# junction that fact requires, and it cannot emit one `pick` move per part.
# Nothing about that is a gap in Pol — it is what keeps a model a finite
# presentation. It is a gap in what a HUMAN should be asked to type: a bank of
# 150 parts is some 4,000 datums, of which ~750 are globally unique junction
# names invented by hand.
#
# The semantics stay entirely in Pol. This emits ordinary, readable, diffable
# datums that `pol check` proves exactly as if they had been written out —
# which is the whole reason it is a generator and not a second language.
#
# Usage:  pol-bank CATALOGUE-DIR [EXTRAS.pol] [--lib PATH]
#
#   CATALOGUE-DIR holds stages.tbl, components.tbl and optionally flows.tbl
#   and actors.tbl. Columns are whitespace-separated, `#` starts a comment,
#   `-` means vacant, and `,` separates a list.
#
#   EXTRAS.pol is appended verbatim — for the transitions a catalogue cannot
#   express, such as a declared `gap`.
set -eu

lib=../lib/arch.lib.pol
dir=
extras=
while [ $# -gt 0 ]; do
  case $1 in
  --lib) lib=$2; shift 2 ;;
  *) if [ -z "$dir" ]; then dir=$1; else extras=$1; fi; shift ;;
  esac
done
[ -n "$dir" ] || { echo "usage: pol-bank CATALOGUE-DIR [EXTRAS.pol] [--lib PATH]" >&2; exit 2; }
for f in stages components; do
  [ -f "$dir/$f.tbl" ] || { echo "pol-bank: missing $dir/$f.tbl" >&2; exit 2; }
done
: >"$dir/.empty.tbl"
flows=$dir/flows.tbl;   [ -f "$flows" ]  || flows=$dir/.empty.tbl
actors=$dir/actors.tbl; [ -f "$actors" ] || actors=$dir/.empty.tbl

awk -v LIB="$lib" '
function emit(arrow, n, names, vals,    i, s) {
  s = "  (" arrow
  for (i = 1; i <= n; i++) s = s " (" names[i] " " (vals[i] == "-" ? "vacant" : vals[i]) ")"
  print s ")"
}
FNR == 1 { file++ }
/^[ \t]*#/ || /^[ \t]*$/ { next }

file == 1 {                                   # stages.tbl
  ns++; stage[ns] = $1; snext[ns] = $2
  nb[ns] = $3; nsc[ns] = $4; nr[ns] = $5; nl[ns] = $6
  next
}
file == 2 {                                   # components.tbl
  nc++; comp[nc] = $1; prov[nc] = $2; reqs[nc] = $3
  cb[nc] = $4; cs[nc] = $5; cr[nc] = $6; cp[nc] = $7; cc[nc] = $8
  cl[nc] = $9; ct[nc] = $10; ce[nc] = $11; cw[nc] = $12
  if ($10 != "-" && !($10 in techseen)) { techseen[$10]; nt++; tech[nt] = $10 }
  if ($12 != "-" && !($12 in bndseen))  { bndseen[$12];  nbd++; bnd[nbd] = $12 }
  next
}
file == 3 { nf++; ff[nf] = $1; ft[nf] = $2; fv[nf] = $3; next }   # flows.tbl
file == 4 { na++; act[na] = $1; adr[na] = $2; next }              # actors.tbl

END {
  print "; GENERATED by pol-bank — do not edit. Edit the catalogue and re-run."
  print ";   pol-bank " ENVIRON["POL_BANK_SRC"] " > this file"
  print ""
  print "(load \"" LIB "\")"
  print ""
  print "(instance bank (of arch)"

  # ---- stages ----
  s = "  (cap"; for (i = 1; i <= ns; i++) s = s " " stage[i]; print s ")"
  emit("next", ns, stage, snext)
  for (i = 1; i <= ns; i++) blank[i] = "-"
  emit("chosen", ns, stage, blank)
  emit("needs-bulk", ns, stage, nb);  emit("needs-scan", ns, stage, nsc)
  emit("needs-rerun", ns, stage, nr); emit("needs-loose", ns, stage, nl)
  print ""

  # ---- presentation rosters ----
  if (nt) { s = "  (technology"; for (i = 1; i <= nt; i++) s = s " " tech[i]; print s ")" }
  if (nbd){ s = "  (boundary";   for (i = 1; i <= nbd; i++) s = s " " bnd[i]; print s ")" }
  print ""

  # ---- components ----
  s = "  (comp"; for (i = 1; i <= nc; i++) s = s " " comp[i]; print s ")"
  emit("bulk", nc, comp, cb);       emit("scans", nc, comp, cs)
  emit("rerunnable", nc, comp, cr); emit("persists", nc, comp, cp)
  emit("couples", nc, comp, cc);    emit("level", nc, comp, cl)
  emit("tech", nc, comp, ct);       emit("external", nc, comp, ce)
  emit("within", nc, comp, cw)
  print ""

  # ---- actors ----
  if (na) {
    s = "  (actor"; for (i = 1; i <= na; i++) s = s " " act[i]; print s ")"
    emit("drives", na, act, adr)
    print ""
  }

  # ---- runtime data flow ----
  if (nf) {
    s = "  (flow"; for (i = 1; i <= nf; i++) { fid[i] = "fl-" ff[i] "-" ft[i]; s = s " " fid[i] }
    print s ")"
    emit("f-from", nf, fid, ff); emit("f-to", nf, fid, ft); emit("f-via", nf, fid, fv)
    print ""
  }

  # ---- provides span: one junction per (component, capability) ----
  np = 0
  for (i = 1; i <= nc; i++) {
    k = split(prov[i], a, ",")
    for (j = 1; j <= k; j++) {
      if (a[j] == "-") continue
      np++; pid[np] = "p-" comp[i] "-" a[j]; pc[np] = comp[i]; pk[np] = a[j]
    }
  }
  s = "  (prov"; for (i = 1; i <= np; i++) s = s " " pid[i]; print s ")"
  emit("p-comp", np, pid, pc); emit("p-cap", np, pid, pk)
  print ""

  # ---- requires span ----
  nq = 0
  for (i = 1; i <= nc; i++) {
    k = split(reqs[i], a, ",")
    for (j = 1; j <= k; j++) {
      if (a[j] == "-") continue
      nq++; qid[nq] = "r-" comp[i] "-" a[j]; qc[nq] = comp[i]; qk[nq] = a[j]
    }
  }
  if (nq) {
    s = "  (req"; for (i = 1; i <= nq; i++) s = s " " qid[i]; print s ")"
    emit("r-comp", nq, qid, qc); emit("r-cap", nq, qid, qk)
    print ""
  }

  print "  (cursor cur)"
  print "  (at (cur " stage[1] ")))"
  print ""
  print "(use arch)"
  print "(initial bank)"
  print ""
  print "; one move per (component, stage) pair — the mapping a form cannot make"
  for (i = 1; i <= np; i++) printf "(pick %s-%s %s %s rr)\n", pk[i], pc[i], pc[i], pk[i]
}
' "$dir/stages.tbl" "$dir/components.tbl" "$flows" "$actors"

rm -f "$dir/.empty.tbl"

if [ -n "$extras" ]; then
  echo
  cat "$extras"
fi
