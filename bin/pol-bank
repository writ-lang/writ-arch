#!/bin/sh
# pol-bank — a component catalogue (Markdown) -> a Pol model (datums).
#
# THIS IS THE TOOL THE LANGUAGE CANNOT BE. A Pol form is rename-and-paste: no
# recursion, no computation, and it cannot map over its `&rest`. So a form
# cannot turn one "component X provides capability Y" row into the named span
# junction that fact requires, and it cannot emit one `pick` move per part.
# Nothing about that is a gap in Pol — it is what keeps a model a finite
# presentation. It is a gap in what a HUMAN should be asked to type.
#
# The semantics stay entirely in Pol. This emits ordinary, readable, diffable
# datums that `pol check` proves exactly as if they had been written out —
# which is the whole reason it is a generator and not a second language.
#
# WHY MARKDOWN. A catalogue is a curated knowledge base that people argue
# about, not a pipeline feed: it wants to render in a pull request, and it wants
# prose. Tables carry the facts, everything else on the page is ignored, and a
# `notes` column documents a row without entering the model.
#
# Usage:  pol-bank CATALOGUE.md [EXTRAS.pol] [--lib PATH]
#
#   Sections are `## Stages`, `## Components`, `## Flows`, `## Actors`.
#   COLUMNS ARE MATCHED BY NAME, so order is free and unknown columns (notes)
#   are skipped. An empty cell or `-` is vacant. `,` separates a list.
#
#   EXTRAS.pol is appended verbatim — for the transitions a catalogue cannot
#   express, such as a declared `gap`.
set -eu

lib=../lib/arch.lib.pol
cat=
extras=
while [ $# -gt 0 ]; do
  case $1 in
  --lib) lib=$2; shift 2 ;;
  *) if [ -z "$cat" ]; then cat=$1; else extras=$1; fi; shift ;;
  esac
done
[ -n "$cat" ] || { echo "usage: pol-bank CATALOGUE.md [EXTRAS.pol] [--lib PATH]" >&2; exit 2; }
[ -f "$cat" ] || { echo "pol-bank: no such catalogue: $cat" >&2; exit 2; }

awk -v LIB="$lib" -v SRC="$cat" '
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
# A trailing `?` marks the cell ASSUMED rather than confirmed. That is
# provenance for `pol-assume`, and no business of the model: it is stripped
# here, so the datums are identical whoever wrote the cell and however sure
# they were. NOTE: no apostrophes in this awk program — it is single-quoted.
function vac(s)  { sub(/\?$/, "", s); return (s == "" || s == "-") ? "-" : s }
# awk runs END even after `exit`, so a fatal must also mute END
function die(m)  { print "pol-bank: " m > "/dev/stderr"; fatal = 1; exit 1 }
function emit(arrow, n, names, vals,   i, s) {
  s = "  (" arrow
  for (i = 1; i <= n; i++) s = s " (" names[i] " " (vals[i] == "-" ? "vacant" : vals[i]) ")"
  print s ")"
}
# value of column NAME in the current row, or "-" if the column is absent
function col(name,   i) { return (name in idx) ? vac(trim(f[idx[name]])) : "-" }
function need(name) { if (!(name in idx)) die("section `" sec "` has no `" name "` column") }

/^##[ \t]/ {
  sec = tolower(trim(substr($0, 4))); delete idx; head = 0; next
}
!/^[ \t]*\|/ { next }                      # prose, headings, HTML comments
/^[ \t]*\|[ \t:|-]*\|[ \t]*$/ { next }     # the |---|---| separator row
{
  line = trim($0)
  sub(/^\|/, "", line); sub(/\|$/, "", line)
  nf = split(line, f, /\|/)
  for (i = 1; i <= nf; i++) f[i] = trim(f[i])

  if (!head) {                             # the header row names the columns
    for (i = 1; i <= nf; i++) if (f[i] != "") idx[f[i]] = i
    head = 1
    next
  }
  if (col("notes") == "-" && nf == 0) next

  if (sec == "stages") {
    need("stage"); need("next")
    ns++; stage[ns] = col("stage"); snext[ns] = col("next")
    nb[ns] = col("needs-bulk"); nsc[ns] = col("needs-scan")
    nr[ns] = col("needs-rerun"); nl[ns] = col("needs-loose")
  } else if (sec == "components") {
    need("name"); need("provides")
    nc++; comp[nc] = col("name"); prov[nc] = col("provides"); reqs[nc] = col("requires")
    cb[nc] = col("bulk");  cs[nc] = col("scans");  cr[nc] = col("rerun")
    cp[nc] = col("persists"); cc[nc] = col("couples")
    cl[nc] = col("level"); ct[nc] = col("tech")
    ce[nc] = col("external"); cw[nc] = col("within")
    if (ct[nc] != "-" && !(ct[nc] in tseen)) { tseen[ct[nc]]; nt++; tech[nt] = ct[nc] }
    if (cw[nc] != "-" && !(cw[nc] in wseen)) { wseen[cw[nc]]; nbd++; bnd[nbd] = cw[nc] }
  } else if (sec == "flows") {
    need("from"); need("to")
    nfl++; ff[nfl] = col("from"); ft[nfl] = col("to"); fv[nfl] = col("via")
  } else if (sec == "actors") {
    need("actor"); need("drives")
    na++; act[na] = col("actor"); adr[na] = col("drives")
  }
}

END {
  if (fatal) exit 1
  if (!ns) die("no `## Stages` table found in " SRC)
  if (!nc) die("no `## Components` table found in " SRC)

  print "; GENERATED by pol-bank — do not edit. Edit the catalogue and re-run:"
  # BASENAME, not the path as given: a generated file whose contents depend on
  # how the generator was invoked is not reproducible, and `regen` would flap
  # between a relative and an absolute call.
  base = SRC; sub(/^.*\//, "", base)
  print ";   pol-bank " base " > this file"
  print ""
  print "(load \"" LIB "\")"
  print ""
  print "(instance bank (of arch)"

  s = "  (cap"; for (i = 1; i <= ns; i++) s = s " " stage[i]; print s ")"
  emit("next", ns, stage, snext)
  for (i = 1; i <= ns; i++) blank[i] = "-"
  emit("chosen", ns, stage, blank)
  emit("needs-bulk", ns, stage, nb);  emit("needs-scan", ns, stage, nsc)
  emit("needs-rerun", ns, stage, nr); emit("needs-loose", ns, stage, nl)
  print ""

  if (nt) { s = "  (technology"; for (i = 1; i <= nt; i++) s = s " " tech[i]; print s ")" }
  if (nbd){ s = "  (boundary";   for (i = 1; i <= nbd; i++) s = s " " bnd[i]; print s ")" }
  print ""

  s = "  (comp"; for (i = 1; i <= nc; i++) s = s " " comp[i]; print s ")"
  emit("bulk", nc, comp, cb);       emit("scans", nc, comp, cs)
  emit("rerunnable", nc, comp, cr); emit("persists", nc, comp, cp)
  emit("couples", nc, comp, cc);    emit("level", nc, comp, cl)
  emit("tech", nc, comp, ct);       emit("external", nc, comp, ce)
  emit("within", nc, comp, cw)
  print ""

  if (na) {
    s = "  (actor"; for (i = 1; i <= na; i++) s = s " " act[i]; print s ")"
    emit("drives", na, act, adr)
    print ""
  }

  if (nfl) {
    s = "  (flow"
    for (i = 1; i <= nfl; i++) { fid[i] = "fl-" ff[i] "-" ft[i]; s = s " " fid[i] }
    print s ")"
    emit("f-from", nfl, fid, ff); emit("f-to", nfl, fid, ft); emit("f-via", nfl, fid, fv)
    print ""
  }

  np = 0
  for (i = 1; i <= nc; i++) {
    k = split(prov[i], a, ",")
    for (j = 1; j <= k; j++) {
      v = trim(a[j]); if (v == "-" || v == "") continue
      np++; pid[np] = "p-" comp[i] "-" v; pc[np] = comp[i]; pk[np] = v
    }
  }
  s = "  (prov"; for (i = 1; i <= np; i++) s = s " " pid[i]; print s ")"
  emit("p-comp", np, pid, pc); emit("p-cap", np, pid, pk)
  print ""

  nq = 0
  for (i = 1; i <= nc; i++) {
    k = split(reqs[i], a, ",")
    for (j = 1; j <= k; j++) {
      v = trim(a[j]); if (v == "-" || v == "") continue
      nq++; qid[nq] = "r-" comp[i] "-" v; qc[nq] = comp[i]; qk[nq] = v
    }
  }
  if (nq) {
    s = "  (req"; for (i = 1; i <= nq; i++) s = s " " qid[i]; print s ")"
    emit("r-comp", nq, qid, qc); emit("r-cap", nq, qid, qk)
    print ""
  }

  print "  (cursor cur)"
  print "  (at (cur " stage[1] ")))"
  print ""
  print "(use arch)"
  print "(initial bank)"
  print ""
  print "; one move per (component, stage) pair — the mapping a form cannot make"
  for (i = 1; i <= np; i++) printf "(pick %s-%s %s %s rr)\n", pk[i], pc[i], pc[i], pk[i]
}
' "$cat"

if [ -n "$extras" ]; then
  echo
  cat "$extras"
fi
